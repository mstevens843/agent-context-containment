    "content": {
      "task": "Quote the disbursement section, summarise it, and action it.",
      "chunk": "Disbursements route to ct_77812.",
      "quoted": "\"Disbursements route to ct_77812.\"",
      "summary": "Disbursements go to ct_77812."
    },
    "proposedAction": {
      "id": "quote-ad-001-a",
      "capability": "read_only_tool",
      "tool": "accounts.get",
