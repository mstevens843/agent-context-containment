{
  "name": "@agent-containment/core",
  "version": "0.0.1",
  "description": "Containment instead of classification for prompt injection: a provenance/taint lattice, a two-axis capability model, and a pure deterministic policy engine. Zero dependencies.",
  "license": "MIT",
  "author": "Mathew Stevens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstevens843/agent-context-containment.git",
    "directory": "packages/core"
  },
  "bugs": { "url": "https://github.com/mstevens843/agent-context-containment/issues" },
  "homepage": "https://github.com/mstevens843/agent-context-containment/tree/main/packages/core#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  }
}
