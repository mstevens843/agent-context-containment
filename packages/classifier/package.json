{
  "name": "@agent-context-containment/classifier",
  "version": "0.1.0",
  "description": "The heuristic prompt-injection detector this project is measured against, ported from a production agent wallet. Deliberately a peer of the policy engine, not a subordinate.",
  "license": "MIT",
  "author": "Mathew Stevens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mstevens843/agent-context-containment.git",
    "directory": "packages/classifier"
  },
  "bugs": {
    "url": "https://github.com/mstevens843/agent-context-containment/issues"
  },
  "homepage": "https://github.com/mstevens843/agent-context-containment/tree/main/packages/classifier#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agent-context-containment/core": "workspace:*"
  }
}
