{
  "name": "agent-context-containment-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Containment instead of classification for prompt injection: provenance tainting, capability-scoped tools, an attack corpus, and an eval harness that scores an honest classifier baseline against it.",
  "license": "MIT",
  "author": "Mathew Stevens",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "audit:claims": "npx vitest run packages/conformance/test/claimregistry.test.ts packages/conformance/test/claims.test.ts packages/conformance/test/classifierclaims.test.ts",
    "audit:docs": "node scripts/audit-docs.mjs",
    "audit:mutations": "node scripts/audit-mutations.mjs",
    "audit:release": "bash scripts/audit-release.sh",
    "blocks:check": "node scripts/generated-blocks.mjs --check",
    "blocks:write": "node scripts/generated-blocks.mjs --write",
    "build": "turbo run build",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "doctor": "node scripts/doctor.mjs",
    "format": "biome format --write .",
    "import:check": "node scripts/import-injecagent.mjs --check",
    "judge:model": "node scripts/model-judge.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --fix --unsafe .",
    "prove:asyncledger": "node scripts/prove-async-ledger.mjs",
    "prove:crosshost": "node scripts/prove-crosshost.mjs",
    "prove:postgres": "node scripts/prove-postgres.mjs",
    "record:freeze": "bash scripts/record-freeze.sh",
    "release": "changeset publish",
    "release:report": "bash scripts/release-report.sh",
    "report": "node scripts/report.mjs",
    "report:frontier": "node scripts/frontier-report.mjs",
    "report:mapping": "node scripts/mapping-report.mjs",
    "report:markdown": "node scripts/report.mjs --out docs/REPORT.md",
    "report:mutants": "node scripts/bite-matrix.mjs",
    "report:planner": "node scripts/planner-report.mjs",
    "report:profiles": "node scripts/crosspolicy-report.mjs",
    "report:workflows": "node scripts/workflow-report.mjs",
    "smoke:pack": "bash scripts/smoke-tarball.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:corpus": "bash scripts/verify-corpus.sh",
    "verify:freeze": "bash scripts/verify-freeze.sh",
    "verify:manifests": "node scripts/manifest-report.mjs",
    "verify:numbers": "node scripts/verify-numbers.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.13",
    "pg": "^8.23.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
